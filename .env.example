# Copy this file to .env and fill it in on your own machine.
# .env is ignored by git. Do not commit it, and do not commit the files
# the prepare scripts write from it.

# Apple Music. The .p8 key stays on your Mac; the prepare script signs a
# short-lived developer token and never uploads the key.
APPLE_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_KEY_FILE=

# Spotify. Authorization Code with PKCE, so there is no client secret.
# Register the redirect URI in the Spotify developer dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=fiber-spotify-login://callback
